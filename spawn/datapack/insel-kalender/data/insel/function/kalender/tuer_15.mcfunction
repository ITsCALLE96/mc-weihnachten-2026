execute if entity @s[tag=insel_kal_hat_15] run return run tellraw @s {"text":"Türchen 15 hast du schon geöffnet.","color":"gray"}
tag @s add insel_kal_hat_15
give @s minecraft:paper[minecraft:item_model="weihnachten:schneemann",minecraft:item_name={text:"Mini-Schneemann"},minecraft:lore=[{text:"Winterkalender 2026 – Tag 15",italic:false,color:"aqua"},{translate:"item.weihnachten.kalender.hinweis.deko",fallback:"Deko: in einen Rahmen hängen",color:"gray",italic:true},{translate:"item.weihnachten.kalender.hinweis.deko2",fallback:"oder einem Rüstungsständer aufsetzen",color:"gray",italic:true}]] 1
