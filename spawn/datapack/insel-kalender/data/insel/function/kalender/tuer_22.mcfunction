execute unless score #tag insel_kalender matches 22.. run return run tellraw @s {"text":"Türchen 22 ist noch zu – es öffnet an Kalendertag 22.","color":"gray"}
execute if entity @s[tag=insel_kal_hat_22] run return run tellraw @s {"text":"Türchen 22 hast du schon geöffnet.","color":"gray"}
tag @s add insel_kal_hat_22
give @s minecraft:leather_helmet[minecraft:item_model="weihnachten:schal",minecraft:item_name={text:"Schal"},minecraft:lore=[{text:"Winterkalender 2026 – Tag 22",italic:false,color:"aqua"},{translate:"item.weihnachten.kalender.hinweis.kopf",fallback:"Aufsetzen: in den Helm-Platz ziehen",color:"gray",italic:true},{translate:"item.weihnachten.kalender.hinweis.frierschutz",fallback:"Schützt vor Frost im Pulverschnee",color:"gray",italic:true}],minecraft:max_stack_size=1,minecraft:equippable={slot:"head",swappable:true},minecraft:attribute_modifiers=[],!minecraft:max_damage,!minecraft:damage] 1
give @s minecraft:cookie[minecraft:item_model="weihnachten:christstollen",minecraft:item_name={text:"Christstollen"},minecraft:lore=[{text:"Winterkalender 2026",italic:false,color:"aqua"},{translate:"item.weihnachten.kalender.hinweis.stollen",fallback:"Essbar: Absorption und kurz Regeneration",color:"gray",italic:true}],minecraft:food={nutrition:6,saturation:14.4},minecraft:consumable={consume_seconds:1.6,animation:"eat",sound:"minecraft:entity.generic.eat",has_consume_particles:true,on_consume_effects:[{type:"minecraft:apply_effects",effects:[{id:"minecraft:absorption",duration:1200,amplifier:0},{id:"minecraft:regeneration",duration:100,amplifier:0}]}]}] 4
tellraw @s [{"text":"Türchen 22 ","color":"gold","bold":true},{"text":"ist offen – frohe Weihnachtszeit!","color":"white"}]
playsound minecraft:entity.player.levelup master @s ~ ~ ~ 0.8 1.6
particle minecraft:firework -0.5 155.8 65.4 0.25 0.25 0.05 0.03 25 normal @s
